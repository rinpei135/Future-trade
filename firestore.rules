rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function jst() { return request.time + duration.value(9, 'h'); }
    // pre：コレクション名の頭（通常モード 'ta5'、ウォルナットモード 'wn5'）
    function dayCol(pre) { return pre + 'd_' + string(jst().year()) + '_' + string(jst().month()) + '_' + string(jst().day()); }
    // math.floor() は小数（2960.0）を返し、string() すると 'ta5w_2960.0' になってクライアントと一致しないため int() で整数にする
    function weekCol(pre) { return pre + 'w_' + string(int(math.floor((request.time.toMillis() + 32400000 + 259200000) / 604800000))); }
    function isRankCol(col, pre) { return col == pre || col.matches(pre + 'd_[0-9]+_[0-9]+_[0-9]+') || col.matches(pre + 'w_[0-9]+'); }
    function writableCol(col, pre) { return col == pre || col == dayCol(pre) || col == weekCol(pre); }
    // base：軍資金、cap：登録できる資産の上限（ranking.js の GAMES と同じ値）
    function validScore(base, cap) {
      let d = request.resource.data;
      return d.keys().hasAll(['nickname','equity','ret','trades','winRate','futureRate','rank','seed','log','ts'])
        && d.keys().hasOnly(['nickname','equity','ret','trades','winRate','futureRate','rank','seed','log','ts'])
        && d.nickname is string && d.nickname.size() > 0 && d.nickname.size() <= 20
        && d.equity is int && d.equity >= 0 && d.equity <= cap
        && d.ret is number && d.ret >= -100 && d.ret <= 1000
        && math.abs(d.ret - (d.equity - base) / (base / 100.0)) < 0.02
        && d.trades is int && d.trades >= 0 && d.trades <= 10000
        && d.winRate is int && d.winRate >= 0 && d.winRate <= 100
        && d.futureRate is int && d.futureRate >= 0 && d.futureRate <= 100
        && d.rank is string && d.rank.size() <= 40
        && d.seed is int && d.seed >= 0 && d.seed <= 4294967295
        && d.log is string && d.log.size() <= 20000
        && d.ts == request.time;
    }
    function validFor(col) {
      return (writableCol(col, 'ta5') && validScore(1000000, 10000000))
        || (writableCol(col, 'wn5') && validScore(300000, 3000000));
    }
    match /{col}/{uid} {
      allow read: if isRankCol(col, 'ta5') || isRankCol(col, 'wn5');
      allow create: if request.auth != null && request.auth.uid == uid && validFor(col);
      allow update: if request.auth != null && request.auth.uid == uid && validFor(col)
        && request.resource.data.equity > resource.data.equity
        && request.time > resource.data.ts + duration.value(60, 's');
      allow delete: if false;
    }
  }
}
